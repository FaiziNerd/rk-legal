# Copy to .env.local (local dev) or set these in the Vercel project settings.
# .env.local is gitignored — never commit secrets. This template is safe to commit.

# --- Contentful (blog) ---
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
# Management token is only needed locally to create/seed content models (not at runtime).
# Not required on Vercel.
CONTENTFUL_MANAGEMENT_TOKEN=

# --- Resend (email) ---
RESEND_API_KEY=
# Verified sender once the domain is set up, e.g. "Romero Kucerkova Law <hello@rklegalcorp.com>".
# Leave empty to use Resend's shared test sender (only delivers to the account owner).
EMAIL_FROM=
# Where contact/referral/newsletter notifications are sent (the firm's inbox).
EMAIL_TO_FIRM=

# --- Site ---
# Production URL, used for metadata/OpenGraph canonical links.
NEXT_PUBLIC_SITE_URL=https://rklegalcorp.com
